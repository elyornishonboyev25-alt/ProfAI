VITE_API_URL=/api/v1
VITE_SPEAKING_WS_URL=
# Optional TURN relay for reliable voice connections across strict mobile/corporate networks.
VITE_WEBRTC_TURN_URL=
VITE_WEBRTC_TURN_USERNAME=
VITE_WEBRTC_TURN_CREDENTIAL=
VITE_GOOGLE_CLIENT_ID=
RESEND_API_KEY=
AUTH_EMAIL_FROM=ProfAI <accounts@profai.uz>
# Global University Journey release gates. Keep every flag false in production
# until its implementation phase has passed QA and received explicit approval.
VITE_GLOBAL_JOURNEY_ENABLED=false
VITE_GUEST_DIAGNOSTIC_ENABLED=false
VITE_UNIVERSITY_DATA_PLATFORM_ENABLED=false
VITE_APPLICATION_WORKSPACE_ENABLED=false
VITE_AUTOMATED_BILLING_ENABLED=false
VITE_GROWTH_RELEASE_ENABLED=false
# Google Gemini API key(s) for AI writing evaluation + study assistant.
# Get keys at https://aistudio.google.com/apikey
# You can add MANY keys to multiply the free daily quota. Two ways (combine if you like):
#   1) Comma-separate them in one var:  VITE_GEMINI_API_KEY=key1,key2,key3
#   2) Or use numbered vars:            VITE_GEMINI_API_KEY_2, _3, _4, _5
# For separate quotas, create each key in a DIFFERENT Google account/project
# (keys in the same project share the same quota).
VITE_GEMINI_API_KEY=
VITE_GEMINI_API_KEY_2=
VITE_GEMINI_API_KEY_3=

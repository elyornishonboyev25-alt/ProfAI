NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:5173
# Local rivojlanish uchun: localhost Postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_test_pro
#
# PRODUCTION (Render) uchun: DOIMIY database ishlating — Render bepul PostgreSQL
# ~30 kunda o'chiriladi va barcha XP/test natijalari yo'qoladi. Neon (bepul, doimiy)
# tavsiya etiladi. Connection string oxiriga ?sslmode=require qo'shing:
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/smart_test_pro?sslmode=require
ACCESS_TOKEN_SECRET=smart_test_pro_access_secret_2026_local_12345
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=smart_test_pro_refresh_secret_2026_local_12345
REFRESH_TOKEN_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
RESEND_API_KEY=
AUTH_EMAIL_FROM=ProfAI <accounts@profai.uz>
GLOBAL_JOURNEY_ENABLED=false
GUEST_DIAGNOSTIC_ENABLED=false
UNIVERSITY_DATA_PLATFORM_ENABLED=false
APPLICATION_WORKSPACE_ENABLED=false
AUTOMATED_BILLING_ENABLED=false
GROWTH_RELEASE_ENABLED=false
# Backend-only generative AI credentials. Never prefix secrets with VITE_.
# GEMINI_API_KEY may contain one key or a comma-separated key list.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
AI_PROVIDER_TIMEOUT_MS=30000
AI_RATE_LIMIT_MAX=30
HF_ACCESS_TOKEN=
HF_API_BASE=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_ASR_URL=https://router.huggingface.co/hf-inference/models/openai/whisper-large-v3-turbo
HF_TIMEOUT_MS=20000
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

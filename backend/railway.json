{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm --prefix backend run build",
    "watchPatterns": ["/backend/**", "/scripts/build-nova-catalog.mjs", "/scripts/lib/novaCatalogSource.ts", "/src/data/**", "/src/features/sat/**", "/tsconfig.json"]
  },
  "deploy": {
    "startCommand": "npm --prefix backend start",
    "preDeployCommand": ["npm --prefix backend run prisma:deploy"],
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}

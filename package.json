    "test:community-browser": "node scripts/test-community-browser.mjs",
    "validate:reading": "node scripts/validate-reading-bank.mjs",
    "validate:listening": "node scripts/validate-listening-bank.mjs",
    "test:listening-browser": "node scripts/test-listening-bank-browser.mjs",
    "test:reading-ui": "node scripts/test-reading-ui.mjs",
    "validate:sat-assets": "node scripts/validate-sat-assets.mjs",
    "validate:sat-test8": "node scripts/validate-sat-test8.mjs",
    "validate:articles": "node scripts/validate-articles.mjs",
    "test:articles-ui": "node scripts/test-articles-ui.mjs",

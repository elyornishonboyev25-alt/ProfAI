    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "chart.js": "^4.4.6",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "framer-motion": "^11.11.11",
    "i18next": "^23.16.4",
    "lucide-react": "^0.563.0",
    "postcss": "^8.4.49",
